{
  "version": 3,
  "routes": [
    { "src": "^/models/[^/]+\\.glb$", "headers": { "cache-control": "public, max-age=31536000, immutable" }, "continue": true },
    { "src": "^/(sfx|voices)\\.(bin|idx\\.json)$", "headers": { "cache-control": "public, max-age=31536000, immutable" }, "continue": true },
    { "src": "^/game\\.js$", "headers": { "cache-control": "public, max-age=31536000, immutable" }, "continue": true },
    { "src": "^/(index\\.html)?$", "headers": { "cache-control": "public, max-age=0, must-revalidate" }, "continue": true },
    { "handle": "filesystem" }
  ]
}
