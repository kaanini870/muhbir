{"v":{"kasap":{"Lafı uzatmayın, dağıtın.":[0,9837],"Bu gece biri konuşacak.":[9837,8277],"Ölmek için erken.":[18114,6597],"Elim hiç titremez.":[24711,7917],"Tetiği çek, vakit kaybetme.":[32628,9957],"Beni bir daha suçlama.":[42585,7197],"Sabrım taşıyor.":[49782,6957],"Muhbir sensin.":[56739,6117],"Yeter. Kart sende.":[62856,8517],"Yanlış adamı seçtin.":[71373,6477],"Biliyordum.":[77850,4317],"Hadi bakalım.":[82167,4317],"Seç birini.":[86484,4677],"Temiz.":[91161,3837],"Kim söndürdü lan ışığı?":[94998,7197],"Otur yerine.":[102195,4557],"Kapat şunu, mahalle duyacak!":[106752,8277],"Farları kapat.":[115029,5157],"Masaya dön.":[120186,4677],"Bu sefer şanslıydı.":[124863,7197],"Çek tetiği.":[132060,4317],"Dağıt.":[136377,3717],"Polis. Kimse kıpırdamasın.":[140094,9117],"Sus. Kapıdalar.":[149211,8157],"Seni unutmadım.":[157368,5757],"Bir can gitti. Kaç kaldı?":[163125,9357],"Acele et.":[172482,4317],"Pazar açık.":[176799,4797],"Geçen sefer beni suçlamıştın. Unutmadım.":[181596,13917],"Geçen sefer para bende kaldı. Yine kalacak.":[195513,15477],"Geçen sefer şanslıydın. Bu sefer değil.":[210990,13557],"Bunu alacaksın.":[224547,5997],"Yakaladım seni.":[230544,5637],"Gördük.":[236181,3837],"Elini indir.":[240018,5157],"Blöf yapıyorsun.":[245175,5637],"Sakin ol.":[250812,4437],"İyi oyundu.":[255249,4797],"Sana güvenmiyorum.":[260046,6717],"Gözünden belli. Sensin.":[266763,10437],"Oyunu kes.":[277200,5037],"Bende değil. Bedelini öde.":[282237,11157],"Hata yaptın.":[293394,4917],"Sana demiştim.":[298311,5517],"Bir muhbir eksildi sayılır.":[303828,8997],"Çabuk ol.":[312825,3837],"Elin titriyor.":[316662,5517],"Bir delil daha gitti.":[322179,7317],"Güzel.":[329496,3477],"Aç şunu. Hemen.":[332973,6717],"Karanlıkta kimse kıpırdamasın.":[339690,9837],"Bir daha dokunma ona.":[349527,7437],"Kaçmayı mı düşünüyorsun?":[356964,6957],"Anahtarı bırak.":[363921,5517],"Gözüm kör oldu, kıs şunu.":[369438,9477],"Seni bekliyoruz.":[378915,5877],"Nereye gidiyorsun?":[384792,5757],"Kartların burada duruyor.":[390549,7437],"Devam.":[397986,3597],"Kart sende kaldı. Kuralı biliyorsun.":[401583,12237],"Sıra silahta.":[413820,5997],"Kimse bu kapıdan çıkmıyor.":[419817,9117],"Bu iş bu gece bitecek.":[428934,8397],"Işıkları kapat, ses çıkarma.":[437331,10197],"Kimse ateş etmesin.":[447528,7317],"Canın yanıyor mu?":[454845,6237],"Bütün gece bekleyemeyiz.":[461082,8277],"Seç artık.":[469359,4797],"Paranı iyi harca.":[474156,6837],"Yine mi sen? Geçen oyunu unutmadım.":[480993,12237],"Seçmek yok. Bunu al.":[493230,8997],"Elini cebimden çek.":[502227,7077],"Yüzün her şeyi söyledi.":[509304,8997],"Komik misin sen?":[518301,5637],"Devam et, sıra sana da gelecek.":[523938,11157],"Koltuktan kalk, masaya gel.":[535095,9957],"Şaltere dokunma.":[545052,6717],"Televizyonu kapat.":[551769,6357],"Bagajdan uzak dur.":[558126,7797],"Kapat şu radyoyu.":[565923,5997],"Paraya dokunma.":[571920,5517],"Kepenge vurma, duyacaklar.":[577437,9477],"Ne yapıyorsun lan?":[586914,5277],"Rahat dur.":[592191,4917],"Bana da bir tane getir.":[597108,6597],"Tren geçiyor. Bekleyin.":[603705,8157],"Gemi kalkıyor. Sabaha az kaldı.":[611862,11397],"Araba geliyor. Susun.":[623259,7917],"Köpekler havlıyor. Dışarıda biri var.":[631176,11277],"Feneri yak.":[642453,4437],"Tüpü bırak, deli misin?":[646890,7797],"Orada çalacak bir şey yok.":[654687,7677],"Oyun bitti. Para benim.":[662364,8637],"Bir el daha.":[671001,4677],"Şansını zorlama.":[675678,6717],"Koz bende.":[682395,5037],"Bunu beklemiyordun, değil mi?":[687432,7557],"Anlaştık. İki tur.":[694989,7797],"Kimseyle anlaşmam.":[702786,6717],"Sözünü tutmadın.":[709503,6357],"Bunu al. Başka kart yok.":[715860,9717],"Et de benim, kemik de.":[725577,9477],"Seni kancaya asacağım.":[735054,8037],"Temiz kesim.":[743091,4557],"Kan kaybediyorsun.":[747648,5997],"Tamam. Ama sırtını dönme.":[753645,9837],"Ben kimseyle ortak olmam.":[763482,9117],"Koltukta yatılmaz, masaya gel.":[772599,11037],"Karanlıkta da keserim.":[783636,6957],"Bıçak bilendi. Başlayalım.":[790593,10437],"Çek bakalım.":[801030,4557],"Hangisi? Düşün.":[805587,8517],"Dikkatli seç.":[814104,5877],"Bir çift daha.":[819981,5397],"Hafifledim.":[825378,4437],"Kartlar yalan söylemez.":[829815,8157],"Yeni tur. Aynı şüphe.":[837972,9717],"Boş çıktı.":[847689,4797],"Şans bu sefer benden yana.":[852486,9597],"Tetik sende.":[862083,5037],"Gözünü kapatma.":[867120,5877],"Kart sende, biliyorum.":[872997,8397],"Yeter bu kadar oyun. Sensin.":[881394,9717],"Yanıldın. Pahalıya patlar.":[891111,10437],"Yakalandın.":[901548,4677],"Maske düştü.":[906225,5397],"Uyuma.":[911622,3477],"Sıra sende, oyalanma.":[915099,8997],"Masa seni bekliyor.":[924096,6837],"Bir can eksildi.":[930933,6477],"Elin gitti.":[937410,5157],"Lafla olmaz bu iş.":[942567,7917]},"doktor":{"Kapat şu radyoyu.":[950484,6117],"Paraya dokunma.":[956601,5517],"Kepenge vurma, duyacaklar.":[962118,9597],"Ne yapıyorsun lan?":[971715,4917],"Rahat dur.":[976632,4797],"Bana da bir tane getir.":[981429,6237],"Tren geçiyor. Bekleyin.":[987666,7797],"Gemi kalkıyor. Sabaha az kaldı.":[995463,10437],"Araba geliyor. Susun.":[1005900,7437],"Köpekler havlıyor. Dışarıda biri var.":[1013337,10917],"Feneri yak.":[1024254,4437],"Tüpü bırak, deli misin?":[1028691,7917],"Orada çalacak bir şey yok.":[1036608,7557],"Oyun bitti. Para benim.":[1044165,8517],"Bir el daha.":[1052682,4677],"Şansını zorlama.":[1057359,6477],"Koz bende.":[1063836,4917],"Bunu beklemiyordun, değil mi?":[1068753,7437],"Anlaştık. İki tur.":[1076190,7797],"Kimseyle anlaşmam.":[1083987,6477],"Sözünü tutmadın.":[1090464,6117],"Nabzına bakayım.":[1096581,5517],"Hasta kurtuldu. Para da.":[1102098,10317],"Belirtiler açık. Sensin.":[1112415,10437],"Bu yara derin.":[1122852,5637],"Anlaştık. Doktor sözü.":[1128489,9357],"Reçeteme uymaz.":[1137846,6477],"Vakit daralıyor, hastam bekliyor.":[1144323,10917],"Elin terli. İlginç.":[1155240,9957],"Ameliyatı karanlıkta yapamam.":[1165197,8157],"Önce yaralıya bakmam lazım.":[1173354,9357],"Çek bakalım.":[1182711,4317],"Hangisi? Düş