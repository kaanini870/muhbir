:[4649340,8637],"Komik misin sen?":[4657977,5997],"Devam et, sıra sana da gelecek.":[4663974,10917],"Koltuktan kalk, masaya gel.":[4674891,9837],"Şaltere dokunma.":[4684728,6837],"Televizyonu kapat.":[4691565,6597],"Bagajdan uzak dur.":[4698162,7557],"Kapat şu radyoyu.":[4705719,7197],"Paraya dokunma.":[4712916,6717],"Kepenge vurma, duyacaklar.":[4719633,10797],"Ne yapıyorsun lan?":[4730430,6597],"Rahat dur.":[4737027,5157],"Bana da bir tane getir.":[4742184,6957],"Tren geçiyor. Bekleyin.":[4749141,9717],"Gemi kalkıyor. Sabaha az kaldı.":[4758858,11517],"Araba geliyor. Susun.":[4770375,8757],"Köpekler havlıyor. Dışarıda biri var.":[4779132,12477],"Feneri yak.":[4791609,5517],"Tüpü bırak, deli misin?":[4797126,8877],"Orada çalacak bir şey yok.":[4806003,8517],"Oyun bitti. Para benim.":[4814520,10077],"Bir el daha.":[4824597,5517],"Şansını zorlama.":[4830114,7317],"Koz bende.":[4837431,5877],"Bunu beklemiyordun, değil mi?":[4843308,8757],"Anlaştık. İki tur.":[4852065,8397],"Kimseyle anlaşmam.":[4860462,7437],"Sözünü tutmadın.":[4867899,6957],"Bir daha çekebilir miyim?":[4874856,8277],"Ben mi kazandım? Gerçekten mi?":[4883133,12237],"Sanırım sensin. Değil mi?":[4895370,10557],"Özür dilerim.":[4905927,5877],"Olur abi, anlaştık.":[4911804,8157],"Tanımadığım adamla anlaşmam.":[4919961,9237],"Abi ışığı açın, hiçbir şey görmüyorum.":[4929198,12597],"Bu sefer hazırım.":[4941795,6117],"Oh, bir tane gitti.":[4947912,8637],"Hadi abi, ben bile bekliyorum.":[4956549,10197],"Çek bakalım.":[4966746,6117],"Hangisi? Düşün.":[4972863,9957],"Dikkatli seç.":[4982820,6597],"Bir çift daha.":[4989417,6597],"Hafifledim.":[4996014,5757],"Kartlar yalan söylemez.":[5001771,8997],"Yeni tur. Aynı şüphe.":[5010768,10317],"Boş çıktı.":[5021085,5517],"Şans bu sefer benden yana.":[5026602,10437],"Tetik sende.":[5037039,6117],"Gözünü kapatma.":[5043156,6597],"Kart sende, biliyorum.":[5049753,9357],"Yeter bu kadar oyun. Sensin.":[5059110,10677],"Yanıldın. Pahalıya patlar.":[5069787,10677],"Yakalandın.":[5080464,5637],"Maske düştü.":[5086101,6597],"Uyuma.":[5092698,4557],"Sıra sende, oyalanma.":[5097255,9717],"Masa seni bekliyor.":[5106972,7077],"Bir can eksildi.":[5114049,7317],"Elin gitti.":[5121366,5877],"Lafla olmaz bu iş.":[5127243,7917]},"anlatici":{"Soygun bitti. Kepenk kapalı, kimse dışarı çıkamıyor.":[5135160,18357],"Dört kişi bir masada. İçlerinden biri polise çalışıyor.":[5153517,17397],"Herkese delil kartları dağıtılır. Her kartın bir eşi vardır.":[5170914,18957],"Tek bir kartın eşi yok: Muhbir. Tur bittiğinde kimin elinde kalırsa bedelini o öder.":[5189871,29877],"Sıra sende. Solundaki oyuncunun elinden bir kart seç.":[5219748,17277],"Eşini bulduğun kart çift olur ve masaya atılır. Bazı çiftler ödül verir: mermi, telsiz, maske ya da bagaj anahtarı.":[5237025,39117],"Sonra sağındaki oyuncu senden çeker. Bir kartına dokunursan onu öne çıkarıp blöf yapabilirsin.":[5276142,28797],"Muhbir kimdeyse çoğu zaman kendini ele verir. Kasap’ın parmaklarına bak.":[5304939,22077],"Mermin varsa birini suçlayabilirsin. Haklıysan o can kaybeder, yanılırsan sen. Şimdi Kasap’ı suçla.":[5327016,33717],"Bütün çiftler atılıp geriye yalnızca Muhbir kalınca tur biter. Kart kimdeyse tabancayı kendine çevirir.":[5360733,32757],"Her turda bir yuva daha dolar. Üç canın var; masada son kalan parayı alır.":[5393490,24237],"Hızlı ve Karanlık modda herkesin bir kozu ve bir zaafı var. Koz oyunda bir kez kullanılır, zaaf hep seninledir.":[5417727,36357],"Karakterini ana menüde Karakterler’den seçersin. Kozun oyunda sol üstte yıldızla durur.":[5454084,27477],"Sıra sende değilken masadan kalkıp garajda dolaşabilirsin.":[5481561,16797],"Arabayı çalıştırabilir, farlarını yakabilirsin.":[5498358,13677],"Anahtar çifti bulursan bagajı açarsın. İçinden mermi, telsiz, maske ya da can çıkar.":[5512035,29277],"Televizyona göz at. Haberler bazen Muhbir’in kimde olduğunu söyler.":[5541312,19797],"Şalteri indirirsen garaj karanlığa gömülür.":[5561109,13677],"Hazırsın. İyi şanslar.":[5574786,9237],"Para masada, kepenk inik. Kasap silahı ortaya koydu: “Kimse çıkmıyor.” Bu gece koz yok, kural yok. Sadece kartlar.":[5584023,42837],"İkinci gece kimse kimseye güvenmiyor. Herkes sakladığı kozu masaya getirdi. Sen de: ilk hatanı affettirecek bir acemi şansın var.":[5626860,41757],"Sokakta siren var, sigorta attı. Kasap dışarıyı kollamaya çıktı; yerine, kapıyı açan Yankesici oturdu. Karanlıkta eller daha hızlı.":[5668617,43557],"Artık beş kişisiniz ve para aynı. Kasap topa bir mermi daha sürdü: “Pay küçüldü, bedel büyüsün.”":[5712174,31917],"Şoför arabayı çalıştırdı, sabaha çıkıyorsunuz. Sessiz ortada yok. Bu gece suçlamak bedava; herkes herkesi gösterecek. Masadan kalkan, muhbirin adını da söyleyecek.":[5744091,53277],"Kepenk inik, yağmur çatıda. Her şeyin başladığı yer.":[5797368,18357],"Yerin iki kat altı. Rampadan inen her araba sizi arıyor olabilir.":[5815725,21237],"Gemi şafakta kalkıyor. Düdüğü duyan, payını alıp binecek.":[5836962,18117],"Yük treni geçerken kimse kimseyi duymaz. Tetik sesi de duyulmaz.":[5855079,20637],"Işıklar söner; bu tur karanlıkta oynanır.":[5875716,14517],"Kapıda polis var: bu tur kimse suçlayamaz.":[5890233,14637],"Televizyon birini işaret ediyor, ama haber yanlış olabilir.":[5904870,17637],"Bu tur rulette topa bir mermi fazla konur.":[5922507,13677],"Bu tur kartlar ters yönde çekilir.":[5936184,11637],"Bu tur suçlamak mermi harcamaz. Yanlış suçlayan yine can verir.":[5947821,22437],"Eniştesinin oto tamircisinde çıraktı. Bu işe “bir kerelik” diye girdi; masadaki en genç ve en çok soru soran o.":[5970258,37437],"Yirmi yıl mezbahada çalıştı. Garaj onun; arabayı da, silahı da o buldu. Kimseye güvenmez, en çok da konuşmayanlara.":[6007695,39477],"Diplomasını bir ameliyattan sonra kaybetti. Kasayı o açtı. Herkesin nabzını bilir; kendi elleri neden titremiyor, kimse sormaz.":[6047172,41397],"Çocukken bir yangından sonra konuşmayı bıraktı. Eski elektrikçi; şalterin yerini gözü kapalı bulur.":[6088569,30237],"Vapur iskelesinde büyüdü, on yaşında ilk cüzdanını aldı. Ekibe soygundan sonra, kapıyı açan kişi olarak katıldı.":[6118806,35157],"Dolmuş şoförüydü, sonra ralliye merak sardı. Motoru hep sıcak tutar; beklemek ona göre değil.":[6153963,29397],"Muhbir sensin. Kart her tur senin elinde başlar. Beş tur hayatta kal: polis yolda.":[6183360,28197],"Polis kepengi kırdı, hepsi yere yattı. Sen arka kapıdan çıktın; dosyan bu gece kapandı.":[6211557,28317],"Masada bir tek sen kaldın. Para senin.":[6239874,12837],"Buraya kadarmış. Garajdan parayla çıkan sen olmadın.":[6252711,16437]},"polis":{"Polis! Etrafınız sarıldı. Kepengi açın!":[6269148,15357],"İçeridekiler! Teslim olun!":[6284505,9237],"Bu son uyarı. Silahları bırakın!":[6293742,11757]},"tv":{"Son dakika. Merkez şubesi soygununda dört şüpheli aranıyor.":[6305499,22077],"Polis, şehirdeki garajları tek tek tarıyor.":[6327576,15837],"Görgü tanıkları kırmızı bir araba gördüklerini söylüyor.":[6343413,16917],"İhbar hattına bir telefon geldi. Polis, içeriden bilgi aldığını doğruladı.":[6360330,23997],"Çalınan paranın iki yüz elli bin lira olduğu açıklandı.":[6384327,16677],"Emniyet müdürü konuştu: Çember daralıyor.":[6401004,15357]}},"license":"ElevenLabs (Türkçe kütüphane sesleri; her karakterin tek sesi var)"}